{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "robotiax",
    "public": "public",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/submitFinalOrder", "function": "submitFinalOrder" },
      { "source": "/generateDemo", "function": "generateDemo" },
      { "source": "/getUploadUrl", "function": "getUploadUrl" }
    ]
  }
}